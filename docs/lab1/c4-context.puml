@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram for TechRepair Hub

Person(client, "Клієнт", "Замовляє послуги ремонту, відстежує статус, погоджує кошторис та оплачує.")
Person(technician, "Майстер / Інженер", "Діагностує пристрої, проводити ремонт, списує деталі.")
Person(admin, "Адміністратор", "Приймає та видає техніку, приймає оплати, керує довідниками.")

System(techRepair, "TechRepair Hub System", "Дозволяє керувати всіма бізнес-процесами сервісного центру: від прийому пристрою до фінансової звітності.")

System_Ext(smsGate, "SMS / Email Gateway", "Зовнішній сервіс відправки повідомлень (наприклад, Twilio / SendGrid).")
System_Ext(paymentGate, "Payment Gateway", "Зовнішня платіжна система (наприклад, LiqPay / Stripe).")
System_Ext(fiscalGate, "ПРРО Сервіс", "Зовнішня система реєстрації розрахункових операцій (наприклад, Checkbox).")

Rel(client, techRepair, "Переглядає стан ремонту, погоджує вартість", "HTTPS / Web")
Rel(admin, techRepair, "Оформлює заявки, видає техніку, формує чеки", "HTTPS / Web App")
Rel(technician, techRepair, "Вносить результати діагностики, змінює статуси", "HTTPS / Web App")

Rel(techRepair, smsGate, "Надсилає повідомлення про зміну статусу", "HTTPS / REST API")
Rel(techRepair, paymentGate, "Ініціалізує платіжні сесії та перевіряє статус", "HTTPS / REST API")
Rel(techRepair, fiscalGate, "Передає дані про розрахункові операції", "HTTPS / REST API")

Rel(smsGate, client, "Доставляє SMS / Email із посиланням на квитанцію", "GSM / SMTP")
Rel(client, paymentGate, "Проводить оплату карткою", "HTTPS")
@enduml