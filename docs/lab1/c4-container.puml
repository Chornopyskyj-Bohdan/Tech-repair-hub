@startuml C4_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram for TechRepair Hub

Person(client, "Клієнт", "Відстежує статус ремонту")
Person(staff, "Персонал (Майстер / Адмін)", "Працює з заявками та складом")

System_Boundary(c1, "TechRepair Hub System") {
    Container(client_portal, "Customer Web Portal", "React, SPA", "Інтерфейс клієнта для перегляду статусу ремонту та онлайн-оплати")
    Container(staff_app, "Staff Web Application", "React / Vue, SPA", "Робоче місце майстра та адміністратора")
    
    Container(api_app, "Core API Application", "C# ASP.NET Core / Node.js", "Модульний моноліт: обробляє бізнес-логіку ремонтів, обліку деталей, розрахунку вартості")
    
    Container(worker, "Background Processing Worker", "C# / Node.js worker process", "Обробка фонових завдань, генерація звітів, повторні відправки SMS")
    
    ContainerDb(database, "Database", "PostgreSQL", "Зберігає дані користувачів, пристроїв, замовлень, запчастин та аудиту")
    Container(message_queue, "Message Queue / Task Store", "Redis / RabbitMQ", "Буферизація фонових завдань і черга сповіщень")
}

System_Ext(smsGate, "SMS / Email Gateway", "Сервіс сповіщень")
System_Ext(paymentGate, "Payment Gateway", "Платіжний шлюз")
System_Ext(fiscalGate, "ПРРО Сервіс", "Фіскалізація чеків")

Rel(client, client_portal, "Використовує", "HTTPS / Web Browser")
Rel(staff, staff_app, "Використовує", "HTTPS / Web Browser")

Rel(client_portal, api_app, "Запити статусів, ініціалізація оплат", "JSON / HTTPS REST")
Rel(staff_app, api_app, "Управління заявками, складом, чеками", "JSON / HTTPS REST")

Rel(api_app, database, "Читає та записує дані", "SQL / TCP (Port 5432)")
Rel(worker, database, "Читає та оновлює фонові статуси", "SQL / TCP (Port 5432)")

Rel(api_app, message_queue, "Публікує фонові задачі (SMS, PDF)", "AMQP / RESP (TCP)")
Rel(worker, message_queue, "Отримує та обробляє задачі", "AMQP / RESP (TCP)")

Rel(worker, smsGate, "Надсилає SMS / Email", "HTTPS / REST API")
Rel(api_app, paymentGate, "Створює платіжні сесії", "HTTPS / REST API")
Rel(api_app, fiscalGate, "Передає чеки", "HTTPS / REST API")

@enduml